{
  "name": "codex-style-markdown",
  "version": "1.0.2",
  "description": "Codex Style Markdown reading and Live Preview with themes, copy tools, and Mermaid zoom for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && node scripts/package.mjs"
  },
  "keywords": ["obsidian", "markdown", "reading", "typography"],
  "author": "geekyfoxlab",
  "repository": {
    "type": "git",
    "url": "https://github.com/geekyfoxlab/codex-style-markdown.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.5",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "jsdom": "^26.1.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  }
}
